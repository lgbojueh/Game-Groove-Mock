# Gmail configuration
SMTP_GMAIL_HOST=smtp.gmail.com
SMTP_GMAIL_PORT=587
SMTP_GMAIL_USER=your-gmail-address@gmail.com
SMTP_GMAIL_PASS=your-gmail-app-password

# Outlook/Hotmail configuration
SMTP_OUTLOOK_HOST=smtp.office365.com
SMTP_OUTLOOK_PORT=587
SMTP_OUTLOOK_USER=your-outlook-address@outlook.com
SMTP_OUTLOOK_PASS=your-outlook-password

# Yahoo configuration
SMTP_YAHOO_HOST=smtp.mail.yahoo.com
SMTP_YAHOO_PORT=465
SMTP_YAHOO_USER=your-yahoo-address@yahoo.com
SMTP_YAHOO_PASS=your-yahoo-password
